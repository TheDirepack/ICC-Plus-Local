{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/iccplus/visual-manifest.schema.json",
  "title": "ICC Plus visual manifest",
  "type": "object",
  "properties": {
    "format": {
      "const": "iccplus-visual-manifest"
    },
    "format_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "styling": {
          "$ref": "#/$defs/styling"
        },
        "customCSS": {
          "type": "string"
        },
        "customCSSAppend": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "design_groups": {
      "type": "object",
      "description": "Reusable native ICC Plus Row/Choice Design Groups. Prefer these over repeating private inline styling on individual Rows or Choices.",
      "additionalProperties": {
        "$ref": "#/$defs/designGroupSpec"
      }
    },
    "defaults": {
      "$ref": "#/$defs/visualSpec"
    },
    "presets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/visualSpec"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visualItem"
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "styling": {
      "type": "object",
      "description": "Native styling fields or objects keyed by native style-group names such as object_image, text, object, row, filter, background, point_bar, or backpack. Runtime validation checks exact field names."
    },
    "visualSpec": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "clear_image": {
          "type": "boolean"
        },
        "template": {},
        "width": {},
        "styling": {
          "$ref": "#/$defs/styling",
          "description": "Private inline styling escape hatch for a single target. Prefer project.styling for global defaults or top-level design_groups plus item design_group(s) for reusable styling."
        },
        "copy_from": {
          "type": "string",
          "minLength": 1
        },
        "copy_image": {
          "type": "boolean"
        },
        "replace_styling": {
          "type": "boolean"
        },
        "unset_styling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "not": {
        "required": [
          "image",
          "clear_image"
        ]
      },
      "additionalProperties": false
    },
    "visualItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preset": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          ]
        },
        "presets": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          ]
        },
        "source": {},
        "credit": {},
        "notes": {},
        "image": {
          "type": "string"
        },
        "clear_image": {
          "type": "boolean"
        },
        "template": {},
        "width": {},
        "styling": {
          "$ref": "#/$defs/styling",
          "description": "Private per-target styling. Use only for a truly one-off Row/Choice case that cannot reasonably be expressed by global styling or a Design Group."
        },
        "copy_from": {
          "type": "string",
          "minLength": 1
        },
        "copy_image": {
          "type": "boolean"
        },
        "replace_styling": {
          "type": "boolean"
        },
        "unset_styling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "where": {
          "type": "object",
          "description": "Bulk selector using the same selector fields as structure/rules/apply."
        },
        "expect": {
          "description": "Expected selected count as an integer or {min,max}. Runtime rejects mismatches."
        },
        "allow_empty": {
          "type": "boolean",
          "default": false
        },
        "design_group": {
          "type": "string",
          "minLength": 1,
          "description": "Assign one official ICC Plus Design Group. Prefer this over item.styling when a reusable style can apply."
        },
        "design_groups": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "Assign one or more official ICC Plus Design Groups. Reusable styling should normally use this field."
        }
      },
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              },
              {
                "required": [
                  "where"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              },
              {
                "required": [
                  "where"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "refs"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "where"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "where"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "image",
              "clear_image"
            ]
          }
        },
        {
          "not": {
            "required": [
              "design_group",
              "design_groups"
            ]
          }
        }
      ]
    },
    "designGroupSpec": {
      "type": "object",
      "description": "Official ICC Plus Design Group definition. The object key is the Design Group ID.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "row",
            "choice"
          ],
          "description": "Whether this creates/updates a Row Design Group or Choice Design Group."
        },
        "name": {
          "type": "string"
        },
        "activated_id": {
          "type": "string",
          "description": "Optional Choice or Global Requirement ID controlling when this Design Group is active."
        },
        "category": {
          "type": "integer"
        },
        "styling": {
          "$ref": "#/$defs/styling"
        },
        "replace_styling": {
          "type": "boolean"
        },
        "unset_styling": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Optional normal ICC Plus Group IDs. Linking a Design Group to a normal Group styles current and future Rows/Choices in that Group without per-entity membership."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
