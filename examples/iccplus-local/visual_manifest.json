{
  "format": "iccplus-visual-manifest",
  "format_version": 1,
  "project": {
    "styling": {
      "background": {
        "bgColorIsOn": true,
        "backgroundColor": "#10131AFF"
      }
    }
  },
  "presets": {
    "portrait-card": {
      "template": 2,
      "width": "col-md-4",
      "styling": {
        "object_image": {
          "objectImageWidth": 100,
          "objectImgOverflowIsOn": true
        },
        "text": {
          "objectTitleAlign": "center"
        }
      }
    }
  },
  "items": [
    {
      "id": "sword",
      "preset": "portrait-card",
      "image": "assets/sword.webp",
      "source": {
        "url": "https://example.invalid/source-page",
        "creator": "Example artist",
        "license": "Record the real license or permission here"
      },
      "credit": "Example artist",
      "notes": "Crop around the blade and hand."
    },
    {
      "id": "shield",
      "preset": "portrait-card",
      "image": "assets/shield.webp"
    },
    {
      "refs": ["fire", "water"],
      "preset": "portrait-card"
    }
  ]
}
